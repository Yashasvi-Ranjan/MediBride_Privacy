# MediBridge Server Environment Variables
PORT=5000

# MongoDB URI (Leave empty or set to mongodb://localhost:27017/medibridge to use automatic in-memory MongoDB)
MONGO_URI=mongodb://localhost:27017/medibridge

# JWT Secrets for Authentication
JWT_SECRET=medibridge_jwt_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=medibridge_refresh_secret_key_change_in_production_2026

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# ML Model Prediction API URL (Python Flask service on port 5001)
MODEL_API_URL=http://localhost:5001

# Cloudinary Storage Configuration (Optional for cloud report uploads; local fallback active)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
